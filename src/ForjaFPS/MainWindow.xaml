<Window x:Class="ForjaFPS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForjaFPS · Optimizador para gaming"
        Width="1180" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <!-- ===== Barra lateral ===== -->
        <Border Grid.RowSpan="2" Background="{StaticResource PanelBrush}" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,8,8,28">
                    <TextBlock FontSize="24" FontWeight="Bold">
                        <Run Text="Forja"/><Run Text="FPS" Foreground="{StaticResource AccentBrush}"/>
                    </TextBlock>
                    <TextBlock Text="Optimizador para gaming" Style="{StaticResource Muted}"/>
                </StackPanel>

                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Style="{StaticResource Muted}"
                           FontSize="11" Margin="8"/>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="Monitor"
                                 Content="📊  Monitor" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="Tweaks"
                                 Content="⚡  Tweaks" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="Debloat"
                                 Content="🧹  Debloat" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Tag="Backup"
                                 Content="🛟  Respaldo" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Contenido ===== -->
        <Grid x:Name="ContentArea" Grid.Column="1">

            <!-- Monitor -->
            <ScrollViewer x:Name="MonitorPanel" VerticalScrollBarVisibility="Auto" Padding="28,24,12,8">
                <StackPanel>
                    <TextBlock Text="Monitor del sistema" Style="{StaticResource Title}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,20"
                               Text="Se actualiza cada 2 segundos solo mientras esta sección está abierta, para no despertar la GPU dedicada en segundo plano."/>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="CpuText" Text="--" FontSize="34" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="CpuBar" Margin="0,10"/>
                                <TextBlock x:Name="CpuDetail" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Memoria RAM" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="RamText" Text="--" FontSize="34" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="RamBar" Margin="0,10"/>
                                <TextBlock x:Name="RamDetail" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="GPU dedicada" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="GpuText" Text="--" FontSize="34" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="GpuBar" Margin="0,10"/>
                                <TextBlock x:Name="GpuDetail" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Memoria de vídeo (VRAM)" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="VramText" Text="--" FontSize="34" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="VramBar" Margin="0,10"/>
                                <TextBlock x:Name="VramDetail" Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Tweaks -->
            <Grid x:Name="TweaksPanel" Margin="28,24,28,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Tweaks" Style="{StaticResource Title}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14"
                               Text="Cada tweak guarda el valor original antes de cambiar nada, así puedes deshacerlo cuando quieras."/>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="0"
                                    Content="Volver a escanear" Click="Rescan_Click"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}"
                                    Content="Seleccionar pendientes" Click="SelectPending_Click"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="🔍 Estado del sistema" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ScanSummary" Style="{StaticResource Muted}" Text="Escaneando..."/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0">
                                    <Run Text="● Aplicado" Foreground="#22C55E"/><Run Text=" por ForjaFPS (se puede deshacer)   "/>
                                    <Run Text="● Ya aplicado" Foreground="#60A5FA"/><Run Text=" por Windows u otra herramienta   "/>
                                    <Run Text="● Parcial" Foreground="#F59E0B"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Perfil:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
                    <Button Style="{StaticResource Btn}" Content="🟢 Seguro" Tag="Seguro" Click="Profile_Click"
                            ToolTip="Solo tweaks sin efectos secundarios"/>
                    <Button Style="{StaticResource Btn}" Content="🎮 Gaming" Tag="Gaming" Click="Profile_Click"
                            ToolTip="Seguros + moderados. Recomendado para uso mixto"/>
                    <Button Style="{StaticResource Btn}" Content="🔥 Extremo" Tag="Extremo" Click="Profile_Click"
                            ToolTip="Todo, incluidos los avanzados. Más calor y consumo en laptops"/>
                    <Button Style="{StaticResource Btn}" Content="Ninguno" Tag="Ninguno" Click="Profile_Click"/>
                </WrapPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TweakList">
                        <ItemsControl.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   Margin="0,14,0,8" Foreground="{StaticResource AccentBrush}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="10"
                                        Padding="14,10" Margin="0,0,10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding RestartText}" Style="{StaticResource Muted}"
                                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Border Background="{Binding RiskLevel, Converter={StaticResource RiskBrush}}"
                                                    CornerRadius="6" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RiskText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#0F1115"/>
                                            </Border>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                       ToolTip="{Binding StatusTip}" FontSize="11" Width="76"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
                    <CheckBox x:Name="RestorePointCheck" IsChecked="True" DockPanel.Dock="Left"
                              Content="Crear punto de restauración antes de aplicar"/>
                    <Button Style="{StaticResource AccentBtn}" DockPanel.Dock="Right" Margin="0"
                            Content="Aplicar seleccionados" Click="Apply_Click"/>
                    <Button Style="{StaticResource Btn}" DockPanel.Dock="Right"
                            Content="Deshacer seleccionados" Click="UndoSelected_Click"/>
                </DockPanel>
            </Grid>

            <!-- Debloat -->
            <Grid x:Name="DebloatPanel" Margin="28,24,28,8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Debloat" Style="{StaticResource Title}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14"
                               Text="Quita apps preinstaladas solo para tu usuario. Las apps de Xbox y Gaming Services no aparecen a propósito: los juegos de Game Pass las necesitan. Cualquier app quitada se puede reinstalar desde la Microsoft Store."/>
                    <TextBlock x:Name="AppxSummary" FontWeight="SemiBold" Margin="0,0,0,14" Text="Escaneando apps..."/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AppxList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="10"
                                        Padding="14,10" Margin="0,0,10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Package}" Style="{StaticResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
                    <Button Style="{StaticResource Btn}" DockPanel.Dock="Left"
                            Content="Seleccionar instaladas" Click="SelectInstalledAppx_Click"/>
                    <Button Style="{StaticResource AccentBtn}" DockPanel.Dock="Right" Margin="0"
                            Content="Quitar seleccionadas" Click="RemoveAppx_Click"/>
                    <Button Style="{StaticResource Btn}" DockPanel.Dock="Right"
                            Content="Refrescar" Click="RefreshAppx_Click"/>
                </DockPanel>
            </Grid>

            <!-- Respaldo -->
            <ScrollViewer x:Name="BackupPanel" VerticalScrollBarVisibility="Auto" Padding="28,24,28,8"
                          Visibility="Collapsed">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Respaldo y deshacer" Style="{StaticResource Title}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,20"
                               Text="ForjaFPS nunca cambia un valor sin guardar antes el original. Si algo no te convence, lo puedes revertir desde aquí."/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Punto de restauración" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                                       Text="Una copia de seguridad de Windows a la que puedes volver desde Recuperación del sistema. Windows solo permite crear uno cada 24 horas."/>
                            <Button Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                    Content="Crear punto de restauración ahora" Click="CreateRestorePoint_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Deshacer todos los tweaks" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock x:Name="BackupSummary" Style="{StaticResource Muted}" Margin="0,4,0,12"/>
                            <Button Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                    Content="Deshacer todo" Click="UndoAll_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Archivo de respaldo" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock x:Name="BackupFolderText" Style="{StaticResource Muted}" Margin="0,4,0,12"/>
                            <Button Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                    Content="Abrir carpeta" Click="OpenBackupFolder_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== Registro de actividad ===== -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource LogBrush}"
                CornerRadius="10" Margin="28,4,28,20" Padding="12,8">
            <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas"
                     FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</Window>
